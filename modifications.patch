--- /dev/null
+++ b/layers/Ablation.py
@@ -0,0 +1,112 @@
+# [MOD] New module implementing ablation components for iTransformer
+import torch  # [MOD]
+import torch.nn as nn  # [MOD]
+import torch.nn.functional as F  # [MOD]
+
+
+class TokenBatchNorm(nn.Module):  # [MOD]
+    """Applies BatchNorm1d(d_model) across all (B * N) variate tokens."""  # [MOD]
+
+    def __init__(self, d_model):  # [MOD]
+        super(TokenBatchNorm, self).__init__()  # [MOD]
+        self.bn = nn.BatchNorm1d(d_model)  # [MOD]
+
+    def forward(self, x):  # [MOD]
+        # x: [B, N, E] -> [B * N, E] -> [B, N, E]  # [MOD]
+        B, N, E = x.shape  # [MOD]
+        x = self.bn(x.reshape(B * N, E))  # [MOD]
+        return x.reshape(B, N, E)  # [MOD]
+
+
+def make_norm(norm_type, d_model):  # [MOD]
+    """Factory for normalization layers: layer, batch, or none."""  # [MOD]
+    if norm_type == "layer":  # [MOD]
+        return nn.LayerNorm(d_model)  # [MOD]
+    elif norm_type == "batch":  # [MOD]
+        return TokenBatchNorm(d_model)  # [MOD]
+    elif norm_type == "none":  # [MOD]
+        return nn.Identity()  # [MOD]
+    else:  # [MOD]
+        raise ValueError(f"Unsupported norm_type: {norm_type}")  # [MOD]
+
+
+class LinearTokenMixer(nn.Module):  # [MOD]
+    """Static linear token mixing (MLP-Mixer style): out = W_o * M * (X W_v).  # [MOD]
+
+    M in R^{N x N} is learned and input-independent.  # [MOD]
+    Matches AttentionLayer forward signature: (queries, keys, values, attn_mask, tau, delta) -> (out, None).  # [MOD]
+    """  # [MOD]
+
+    def __init__(self, n_tokens, d_model):  # [MOD]
+        super(LinearTokenMixer, self).__init__()  # [MOD]
+        self.n_tokens = n_tokens  # [MOD]
+        self.value_projection = nn.Linear(d_model, d_model)  # [MOD]
+        self.token_mix = nn.Linear(n_tokens, n_tokens, bias=False)  # [MOD]
+        self.out_projection = nn.Linear(d_model, d_model)  # [MOD]
+
+    def forward(self, queries, keys, values, attn_mask=None, tau=None, delta=None):  # [MOD]
+        # values: [B, N, E]  # [MOD]
+        B, N, E = values.shape  # [MOD]
+        if N != self.n_tokens:  # [MOD]
+            raise ValueError(  # [MOD]
+                f"LinearTokenMixer expected {self.n_tokens} tokens, got {N}."  # [MOD]
+            )  # [MOD]
+        v = self.value_projection(values)  # [B, N, E]  # [MOD]
+        mixed = self.token_mix(v.transpose(1, 2)).transpose(1, 2)  # [B, N, E]  # [MOD]
+        out = self.out_projection(mixed)  # [B, N, E]  # [MOD]
+        return out, None  # [MOD]
+
+
+class AblationEncoderLayer(nn.Module):  # [MOD]
+    """Configurable EncoderLayer preserving exact parameter creation order of EncoderLayer in baseline mode."""  # [MOD]
+
+    def __init__(  # [MOD]
+        self,  # [MOD]
+        attention,  # [MOD]
+        d_model,  # [MOD]
+        d_ff=None,  # [MOD]
+        dropout=0.1,  # [MOD]
+        activation="relu",  # [MOD]
+        norm_type="layer",  # [MOD]
+        ffn_type="mlp",  # [MOD]
+        residual=True,  # [MOD]
+    ):  # [MOD]
+        super(AblationEncoderLayer, self).__init__()  # [MOD]
+        d_ff = d_ff or 4 * d_model  # [MOD]
+        # Preserve exact initialization order: attention, conv1/conv2 (or linear), norm1, norm2  # [MOD]
+        self.attention = attention  # [MOD]
+        self.ffn_type = ffn_type  # [MOD]
+        self.residual = bool(residual)  # [MOD]
+        if ffn_type == "mlp":  # [MOD]
+            self.conv1 = nn.Conv1d(in_channels=d_model, out_channels=d_ff, kernel_size=1)  # [MOD]
+            self.conv2 = nn.Conv1d(in_channels=d_ff, out_channels=d_model, kernel_size=1)  # [MOD]
+        elif ffn_type == "linear":  # [MOD]
+            self.ffn_linear = nn.Linear(d_model, d_model)  # [MOD]
+        else:  # [MOD]
+            raise ValueError(f"Unsupported ffn_type: {ffn_type}")  # [MOD]
+        self.norm1 = make_norm(norm_type, d_model)  # [MOD]
+        self.norm2 = make_norm(norm_type, d_model)  # [MOD]
+        self.dropout = nn.Dropout(dropout)  # [MOD]
+        self.activation = F.relu if activation == "relu" else F.gelu  # [MOD]
+
+    def forward(self, x, attn_mask=None, tau=None, delta=None):  # [MOD]
+        if self.attention is not None:  # [MOD]
+            new_x, attn = self.attention(  # [MOD]
+                x, x, x,  # [MOD]
+                attn_mask=attn_mask,  # [MOD]
+                tau=tau, delta=delta  # [MOD]
+            )  # [MOD]
+            new_x = self.dropout(new_x)  # [MOD]
+            x = x + new_x if self.residual else new_x  # [MOD]
+        else:  # [MOD]
+            attn = None  # [MOD]
+
+        y = x = self.norm1(x)  # [MOD]
+        if self.ffn_type == "mlp":  # [MOD]
+            y = self.dropout(self.activation(self.conv1(y.transpose(-1, 1))))  # [MOD]
+            y = self.dropout(self.conv2(y).transpose(-1, 1))  # [MOD]
+        else:  # [MOD]
+            y = self.dropout(self.ffn_linear(y))  # [MOD]
+
+        out = x + y if self.residual else y  # [MOD]
+        return self.norm2(out), attn  # [MOD]
